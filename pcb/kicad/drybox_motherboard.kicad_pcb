(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 1.6)
  )

  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0.1)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros false)
      (usegerberextensions true)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (svguseinch false)
      (svgprecision 6)
      (excludeedgelayer true)
      (plotframeref false)
      (viasonmask false)
      (mode 1)
      (useauxorigin false)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (dxfpolygonmode true)
      (dxfimperialunits true)
      (dxfusepcbnewfont true)
      (psnegative false)
      (psa4output false)
      (plotreference true)
      (plotvalue true)
      (plotinvisibletext false)
      (sketchpadsonfab false)
      (subtractmaskfromsilk false)
      (outputformat 1)
      (mirror false)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "gerber/")
    )
  )

  (net 0 "")
  (net 1 "+24V_IN")
  (net 2 "+24V_BUS")
  (net 3 "GND")
  (net 4 "+5V_BUS")
  (net 5 "+3.3V_BUS")
  (net 6 "PWM_PTC")
  (net 7 "PWM_PURGE")
  (net 8 "OUT_PTC")
  (net 9 "OUT_PURGE")
  (net 10 "I2C_SDA")
  (net 11 "I2C_SCL")
  (net 12 "SPI_CS")
  (net 13 "SPI_DC")
  (net 14 "SPI_RST")
  (net 15 "SPI_MOSI")
  (net 16 "SPI_SCK")
  (net 17 "SPI_MISO")
  (net 18 "SPI_T_CS")
  (net 19 "+24V_PTC_FUSED")

  ;; Edge.Cuts (100mm x 100mm)
  (gr_rect (start 0 0) (end 100 100) (layer "Edge.Cuts") (width 0.15) (fill none))

  ;; Textos de Serigrafia
  ;; Textos de Serigrafia Detalhados
  ;; Textos de Serigrafia Corrigidos
  (gr_text "DRYBOX 60L PRO - MOTHERBOARD SHIELD V1.1" (at 28.5 97) (layer "F.SilkS") (effects (font (size 1.05 1.05) (thickness 0.18))))
  (gr_text "J1: 24V IN" (at 17.5 93.5) (layer "F.SilkS") (effects (font (size 0.85 0.85) (thickness 0.18))))
  (gr_text "F1: FUSIVEL 10A" (at 33.7 93.5) (layer "F.SilkS") (effects (font (size 0.85 0.85) (thickness 0.18))))
  (gr_text "STEP-DOWN LM2596 (5.00V)" (at 69 88.5) (layer "F.SilkS") (effects (font (size 1.05 1.05) (thickness 0.18))))
  (gr_text "CALIBRAR 5.00V ANTES DE PLUGAR ESP32!" (at 69 85) (layer "F.SilkS") (effects (font (size 0.75 0.75) (thickness 0.18))))
  (gr_text "ESP32-S3" (at 24.7 61.5) (layer "F.SilkS") (effects (font (size 1.3 1.3) (thickness 0.18))))
  (gr_text "WROOM-1 N16R8" (at 24.7 56.5) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.18))))
