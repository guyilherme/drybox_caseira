  (gr_text "10:CS" (at 42.5 56.8) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.18))))
  (gr_text "11:MOSI" (at 43.5 54.3) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.18))))
  (gr_text "12:SCK" (at 43 51.8) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.18))))
  (gr_text "13:MISO" (at 43.5 49.2) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.18))))
  (gr_text "14:RST" (at 43 46.7) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.18))))
  (gr_text "3.3V" (at 42 44.1) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.18))))
  (gr_text "PINOS 35, 36, 37 PROIBIDOS (PSRAM)" (at 24.7 26.5) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.18))))
  (gr_text "MOSFET 1: AQUECEDOR PTC" (at 59.5 71.5) (layer "F.SilkS") (effects (font (size 0.9 0.9) (thickness 0.18))))
  (gr_text "MOSFET 2: PURGA 24V" (at 59.5 47.5) (layer "F.SilkS") (effects (font (size 0.9 0.9) (thickness 0.18))))
  (gr_text "J3: TERMOFUSIVEL 75C" (at 74 70) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.18))))
  (gr_text "J2: AQUECEDOR PTC" (at 74 55) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.18))))
  (gr_text "J4: FAN PTC 24V" (at 74 40) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.18))))
  (gr_text "J5: PURGA 24V" (at 74 25) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.18))))
  (gr_text "J6: DISPLAY TFT 2.4 SPI + TOUCH" (at 36.5 13.5) (layer "F.SilkS") (effects (font (size 0.85 0.85) (thickness 0.18))))
  (gr_text "PINO 8: LED = 3.3V OBRIGATORIO!" (at 36.5 1.2) (layer "F.SilkS") (effects (font (size 0.65 0.65) (thickness 0.18))))
  (gr_text "J7: SHT31 #1 (0x44)" (at 68 13.5) (layer "F.SilkS") (effects (font (size 0.75 0.75) (thickness 0.18))))
  (gr_text "J8: SHT31 #2 (0x45)" (at 83 13.5) (layer "F.SilkS") (effects (font (size 0.75 0.75) (thickness 0.18))))

  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu") (at 5 5)
    (pad "1" thru_hole circle (at 0 0) (size 6.0 6.0) (drill 3.2) (layers *.Cu *.Mask) (net 3 "GND"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu") (at 95 5)
    (pad "1" thru_hole circle (at 0 0) (size 6.0 6.0) (drill 3.2) (layers *.Cu *.Mask) (net 3 "GND"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu") (at 5 95)
    (pad "1" thru_hole circle (at 0 0) (size 6.0 6.0) (drill 3.2) (layers *.Cu *.Mask) (net 3 "GND"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu") (at 95 95)
    (pad "1" thru_hole circle (at 0 0) (size 6.0 6.0) (drill 3.2) (layers *.Cu *.Mask) (net 3 "GND"))
  )

  ;; Conector J1 (Entrada 24V)
  (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm" (layer "F.Cu") (at 17.54 90)
    (pad "1" thru_hole rect (at -2.54 0) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 1 "+24V_IN"))
    (pad "2" thru_hole circle (at 2.54 0) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 3 "GND"))
  )

  ;; Porta-Fusivel F1
  (footprint "Fuse:Fuseholder_Blade_Mini_Keystone_3568" (layer "F.Cu") (at 33.75 90)
    (pad "1" thru_hole rect (at -3.75 0) (size 2.8 2.8) (drill 1.3) (layers *.Cu *.Mask) (net 1 "+24V_IN"))
    (pad "2" thru_hole circle (at 3.75 0) (size 2.8 2.8) (drill 1.3) (layers *.Cu *.Mask) (net 2 "+24V_BUS"))
  )

  ;; Modulo Step-Down LM2596
  (footprint "Module:LM2596_StepDown_Module" (layer "F.Cu") (at 69 87.5)
    (pad "1" thru_hole rect (at -19 7.5) (size 2.4 2.4) (drill 1.2) (layers *.Cu *.Mask) (net 2 "+24V_BUS"))
    (pad "2" thru_hole circle (at -19 -7.5) (size 2.4 2.4) (drill 1.2) (layers *.Cu *.Mask) (net 3 "GND"))
    (pad "3" thru_hole rect (at 19 7.5) (size 2.4 2.4) (drill 1.2) (layers *.Cu *.Mask) (net 4 "+5V_BUS"))
    (pad "4" thru_hole circle (at 19 -7.5) (size 2.4 2.4) (drill 1.2) (layers *.Cu *.Mask) (net 3 "GND"))
  )

  ;; Bornes de Saida (J3, J2, J4, J5)
  (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm" (layer "F.Cu") (at 90 69.46)
    (pad "1" thru_hole rect (at 0 2.54) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 2 "+24V_BUS"))
    (pad "2" thru_hole circle (at 0 -2.54) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 19 "+24V_PTC_FUSED"))
  )
  (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm" (layer "F.Cu") (at 90 54.46)
    (pad "1" thru_hole rect (at 0 2.54) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 19 "+24V_PTC_FUSED"))
    (pad "2" thru_hole circle (at 0 -2.54) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 8 "OUT_PTC"))
  )
  (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm" (layer "F.Cu") (at 90 39.46)
    (pad "1" thru_hole rect (at 0 2.54) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 2 "+24V_BUS"))
    (pad "2" thru_hole circle (at 0 -2.54) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 3 "GND"))
  )
  (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm" (layer "F.Cu") (at 90 24.46)
    (pad "1" thru_hole rect (at 0 2.54) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 2 "+24V_BUS"))
    (pad "2" thru_hole circle (at 0 -2.54) (size 2.5 2.5) (drill 1.3) (layers *.Cu *.Mask) (net 9 "OUT_PURGE"))
  )

  ;; Trilhas Principais (Segmentos de Cobre)
  (segment (start 15 90) (end 30 90) (width 3.0) (layer "F.Cu") (net 1))
  (segment (start 15 90) (end 30 90) (width 3.0) (layer "B.Cu") (net 1))
  (segment (start 37.5 90) (end 50 95) (width 2.5) (layer "F.Cu") (net 2))
  (segment (start 50 95) (end 52 68) (width 2.5) (layer "F.Cu") (net 2))
  (segment (start 52 68) (end 90 72) (width 2.5) (layer "F.Cu") (net 2))
  (segment (start 62.16 68) (end 90 51.92) (width 3.0) (layer "F.Cu") (net 8))
  (segment (start 62.16 68) (end 90 51.92) (width 3.0) (layer "B.Cu") (net 8))
  (segment (start 62.16 44) (end 90 21.92) (width 2.5) (layer "F.Cu") (net 9))

)
